meta {
  name: Me
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/me
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("response has the correct username", function () {
    expect(res.body.username).to.equal("demo@example.com");
  });
}
