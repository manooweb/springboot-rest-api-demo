meta {
  name: Update Project
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "name": "My first project updated",
  "description": "Updated from Bruno"
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("name changed to My first project updated", function () {
    expect(res.body.name).to.equal("My first project updated");
  });

  test("description changed to Updated from Bruno", function () {
    expect(res.body.description).to.equal("Updated from Bruno");
  });
}
