meta {
  name: Get Project
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}
  auth: inherit
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("id matches projectId", function () {
    expect(res.body.id).to.equal(bru.getVar("projectId"));
  });
}
