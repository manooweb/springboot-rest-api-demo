meta {
  name: Get Project by id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}
  body: none
  auth: none
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });

  test("id matches", function () {
    expect(res.body.id).to.equal(bru.getEnvVar("projectId"));
  });
}
