meta {
  name: Update Task
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/v1/tasks/{{taskId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "My first task updated from Bruno",
    "description": "Updated from Bruno",
    "dueDate": "2026-01-16",
    "status": "DONE"
  }
}

vars:pre-request {
  taskId: c9cb7f6e-6d84-4b41-801b-6bd1fc781a9b
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });
  
  test("response has id", function () {
    expect(res.body.id).to.be.a("string");
  });
}
