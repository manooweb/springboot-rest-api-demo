meta {
  name: Update Task
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/v1/tasks/{{taskId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "My first task updated from Bruno",
    "description": "Updated from Bruno",
    "dueDate": "2026-01-16",
    "status": "DONE"
  }
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("response has id", function () {
    expect(res.body.id).to.be.a("string");
  });
}
