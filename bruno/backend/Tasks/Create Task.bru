meta {
  name: Create Task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/tasks
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "My first task",
    "description": "Created from Bruno",
    "dueDate": "2026-01-02",
    "status": "TODO"
  }
}

tests {
  test("status is 201", function () {
    expect(res.status).to.equal(201);
  });

  test("response has id", function () {
    expect(res.body.id).to.be.a("string");
  });

  test("save taskId", function () {
    bru.setEnvVar("taskId", res.body.id);
  });
}
