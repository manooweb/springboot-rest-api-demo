meta {
  name: Update Task Status
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/v1/tasks/{{taskId}}/status
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "DONE"
  }
}

vars:pre-request {
  taskId: fa7219c5-0165-472c-a4b5-ae9686c3ede2
}

tests {
  test("status is 200", function () {
    expect(res.status).to.equal(200);
  });
  
  test("status changed to DONE", function () {
    expect(res.body.status).to.equal("DONE");
  });
}
